# Password for the site-wide HTTP Basic Auth gate (see middleware.ts).
# Server-only — do NOT use a NEXT_PUBLIC_/VITE_ prefix, or it would be exposed
# to the client bundle. Leave unset to disable the gate (e.g. for local dev).
#
# Copy this file to .env.local (git-ignored) and set a real value there.
# In production, set SITE_AUTH_PASSWORD in the Vercel project's Environment
# Variables — never commit the real value.
SITE_AUTH_PASSWORD=
